{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:court-document-library:agent-skills:1.0.0",
  "title": "Agent Skills Library catalog",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "record_count",
    "counts",
    "scope",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "record_count": {
      "type": "integer",
      "minimum": 1
    },
    "counts": {
      "type": "object"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "legacy_aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "type": "object",
      "required": [
        "repo",
        "url",
        "commit",
        "path",
        "license",
        "sha256",
        "included_path"
      ],
      "properties": {
        "repo": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "included_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "origin",
        "category",
        "roles",
        "summary",
        "description",
        "when_to_use",
        "inputs",
        "steps",
        "outputs",
        "examples",
        "checks",
        "limits",
        "tool_requirements",
        "jurisdiction",
        "readiness",
        "source",
        "files",
        "related_ids",
        "runtime_installed",
        "legal_accuracy_evaluated",
        "instructions",
        "instructions_sha256",
        "instruction_path",
        "platform"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "agent",
            "skill",
            "workflow"
          ]
        },
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "Research & authority",
            "Discovery & evidence",
            "Drafting & documents",
            "Court practice",
            "Contracts & transactions",
            "Regulatory & compliance",
            "Privacy & privilege",
            "Operations & quality",
            "Design & communication",
            "Coordination"
          ]
        },
        "roles": {
          "$ref": "#/$defs/strings"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 60
        },
        "when_to_use": {
          "$ref": "#/$defs/strings"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "required",
              "description"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "steps": {
          "$ref": "#/$defs/strings"
        },
        "outputs": {
          "$ref": "#/$defs/strings"
        },
        "examples": {
          "$ref": "#/$defs/strings"
        },
        "checks": {
          "$ref": "#/$defs/strings"
        },
        "limits": {
          "$ref": "#/$defs/strings"
        },
        "tool_requirements": {
          "$ref": "#/$defs/strings"
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "readiness": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "pattern": "^https?://"
              }
            },
            "oneOf": [
              {
                "required": [
                  "path"
                ]
              },
              {
                "required": [
                  "url"
                ]
              }
            ]
          }
        },
        "related_ids": {
          "$ref": "#/$defs/strings"
        },
        "source_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile_kind": {
          "enum": [
            "specialist",
            "orchestrator",
            "profile_only"
          ]
        },
        "runtime_installed": {
          "const": false
        },
        "legal_accuracy_evaluated": {
          "const": false
        },
        "instructions": {
          "type": [
            "string",
            "null"
          ]
        },
        "instructions_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "instruction_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "platform": {
          "areas": [],
          "binding_status": "Host integration required; no runtime is installed",
          "runtime_verified": false
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "profile_kind"
            ],
            "properties": {
              "profile_kind": {
                "const": "profile_only"
              }
            }
          },
          "then": {
            "properties": {
              "readiness": {
                "const": "Profile only"
              },
              "source_prompt": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
